# Pontis Atelier — environment variables.
# Copy to `.env` and fill in. None of these are baked into the bundle —
# the server reads them at runtime.

# ── Server ───────────────────────────────────────────────────────────────────
# Port + bind interface for the Express server. Default 3000 / 0.0.0.0.
PORT=3000
HOST=0.0.0.0

# Path to the SQLite database file. Defaults to ./data/atelier.db.
# Make sure this path is writable by the process and on persistent storage.
ATELIER_DB_PATH=./data/atelier.db

# ── Admin (/admin page) — HTTP Basic Auth ───────────────────────────────────
# Browser pops the native credential prompt when anyone hits /admin or
# /api/admin/*. Same Authorization header unlocks both routes.
#
# Username defaults to "admin". Password (ADMIN_SECRET) is required —
# without it, admin routes return 503. Pick a strong password.
ADMIN_USERNAME=admin
ADMIN_SECRET=change-me-to-a-strong-password
# Optional: override the WWW-Authenticate realm string (shown in some
# browser credential prompts). Default: "Pontis Atelier Admin"
# ADMIN_REALM=Pontis Atelier Admin

# ── Hey Pontis (Claude-backed planner) ───────────────────────────────────────
# Generated with `claude setup-token` on a host where Claude Code is installed.
# Routes API calls through your Claude Max subscription quota instead of
# paid API credits. Starts with `sk-ant-oat01-`.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional override of the planner model. Defaults to claude-opus-4-7.
# ATELIER_PLANNER_MODEL=claude-sonnet-4-6

# Fallback: a regular Anthropic API key. Used only if CLAUDE_CODE_OAUTH_TOKEN
# isn't set. Either is fine; OAuth is preferred since it uses your subscription.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Notifications (optional) ─────────────────────────────────────────────────
# Email recipient surfaced in the Finalize "email this plan" mailto button.
# This is exposed to the browser (it's the recipient address; safe to ship).
VITE_FINALIZE_NOTIFY_EMAIL=team@fightingsmartcyber.com

# Optional 3rd-party webhook that fires on every finalize, in addition to the
# Atelier backend. Useful for piping snapshots into Slack/Discord/n8n.
# VITE_FINALIZE_WEBHOOK_URL=https://hooks.slack.com/services/...
